<section class="cart-page"><div class="container"><div class="section-head"><div><div class="eyebrow">Your bag</div><h2>Cart</h2></div><a class="btn btn-secondary" href="{{ routes.all_products_collection_url }}">Continue shopping →</a></div>{% if cart.item_count == 0 %}<div class="card" style="padding:40px;text-align:center"><h3>Your cart is waiting for something great.</h3><a class="btn btn-primary" href="{{ routes.collections_url }}">Explore products</a></div>{% else %}<div class="cart-layout"><div>{% for item in cart.items %}<div class="cart-item"><img src="{{ item.image | image_url: width:180 }}" loading="lazy" alt="{{ item.title | escape }}"><div><h3>{{ item.product.title }}</h3><p class="muted">{{ item.variant.title }}</p><strong>{{ item.final_line_price | money }}</strong></div><div class="item-total"><label class="muted" for="Qty-{{ item.key }}">Qty</label><input class="qty" id="Qty-{{ item.key }}" data-cart-quantity="{{ item.key }}" type="number" min="0" value="{{ item.quantity }}"></div></div>{% endfor %}</div><aside class="cart-summary"><h3>Order summary</h3><div class="summary-row"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><div class="summary-row"><span>Shipping</span><span>Calculated at checkout</span></div><div class="summary-total">Total <span style="float:right">{{ cart.total_price | money }}</span></div><a class="btn btn-primary" style="width:100%;margin-top:16px" href="{{ routes.checkout_url }}">Secure checkout →</a><p class="muted" style="font-size:11px;margin-top:12px">Taxes and shipping are calculated at checkout.</p></aside></div>{% endif %}</div></section>