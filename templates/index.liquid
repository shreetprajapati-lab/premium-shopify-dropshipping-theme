<section class="hero"><div class="container hero-inner"><div class="hero-copy reveal"><div class="eyebrow">A smarter way to discover</div><h1>Find what fits your life.</h1><p>Curated products, clear value and a shopping experience built to move at your pace.</p><div class="hero-actions"><a class="btn btn-primary" href="{{ routes.collections_url }}">Explore collection →</a><a class="btn btn-secondary" href="/collections/new-arrivals">See new arrivals</a></div></div><div class="hero-orbit" aria-hidden="true"></div></div></section>
<section class="trust"><div class="container trust-row"><div class="trust-item">✓ Secure payments</div><div class="trust-item">↗ Fast delivery</div><div class="trust-item">↺ Easy returns</div><div class="trust-item">◇ Quality products</div><div class="trust-item">⌁ Customer support</div></div></section>
<section class="section"><div class="container"><div class="section-head reveal"><div><div class="eyebrow">Explore</div><h2>Shop by category</h2><p class="muted">Start with what you need. Discover what you didn't.</p></div><a class="btn btn-secondary" href="{{ routes.collections_url }}">View all</a></div><div class="grid category-grid">{% for collection in collections limit:4 %}<a class="category-card card reveal" href="{{ collection.url }}">{% if collection.featured_image %}<img src="{{ collection.featured_image | image_url: width:700 }}" loading="lazy" alt="{{ collection.title | escape }}">{% endif %}<div class="category-copy"><h3>{{ collection.title }}</h3><span>Explore →</span></div></a>{% endfor %}</div></div></section>
{% assign featured = collections['all'] %}<section class="section" style="padding-top:20px"><div class="container"><div class="section-head reveal"><div><div class="eyebrow">Curated now</div><h2>Trending products</h2></div><a class="btn btn-secondary" href="{{ routes.all_products_collection_url }}">Shop all</a></div><div class="grid products-grid">{% for product in featured.products limit:8 %}<article class="product-card card reveal"><a href="{{ product.url }}"><div class="product-media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width:800 }}" loading="lazy" alt="{{ product.featured_image.alt | escape | default: product.title }}">{% endif %}{% if product.compare_at_price > product.price %}<span class="badge">Sale</span>{% endif %}<span class="icon-btn wishlist" aria-hidden="true">♡</span></div><div class="product-info"><h3>{{ product.title }}</h3><div class="rating">★★★★★ <span class="muted">Shopify reviews</span></div><div class="price-row"><span class="price">{{ product.price | money }}</span>{% if product.compare_at_price > product.price %}<span class="compare">{{ product.compare_at_price | money }}</span>{% endif %}</div></a><form method="post" action="{{ routes.cart_add_url }}" class="quick-add-form"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="btn btn-primary quick-add" type="submit" {% unless product.available %}disabled{% endunless %}>Add to cart</button></form></div></article>{% endfor %}</div></div></section>
<section class="section"><div class="container"><div class="deal reveal"><div class="deal-head"><div><div class="eyebrow" style="color:#9eb9ff">Limited collection</div><h2 style="color:#fff">Fresh finds, better value.</h2><p style="color:#b9c1cf">Discover current offers from your live Shopify catalog.</p></div><a class="btn btn-secondary" href="/collections/deals">Shop deals →</a></div></div></div></section>
<section class="section"><div class="container"><div class="section-head reveal"><div><div class="eyebrow">Personalised discovery</div><h2>Made for more browsing.</h2><p class="muted">Build your storefront around live Shopify collections—best sellers, new arrivals, top rated and more.</p></div></div><div class="grid category-grid"><a class="card" style="padding:26px" href="/collections/best-sellers"><h3>Best Sellers →</h3><p class="muted">What's moving fastest.</p></a><a class="card" style="padding:26px" href="/collections/new-arrivals"><h3>New Arrivals →</h3><p class="muted">Freshly added to the store.</p></a><a class="card" style="padding:26px" href="/collections/under-499"><h3>Under ₹499 →</h3><p class="muted">Everyday finds at a glance.</p></a><a class="card" style="padding:26px" href="/collections/top-rated"><h3>Top Rated →</h3><p class="muted">Your review app can power this collection.</p></a></div></div></section>
<section class="section"><div class="container"><div class="newsletter reveal"><div class="eyebrow">Stay in the loop</div><h2>Get the best finds first.</h2><p class="muted">New drops, useful discoveries and offers—without the noise.</p>{% form 'customer', class:'newsletter-form' %}<input type="email" name="contact[email]" placeholder="Your email address" required aria-label="Email address"><button class="btn btn-primary" type="submit">Subscribe</button>{% endform %}</div></div></section>