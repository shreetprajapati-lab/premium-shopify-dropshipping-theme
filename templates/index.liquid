<section class="hero"><div class="hero-bg" aria-hidden="true"></div><div class="container hero-inner"><div class="hero-copy reveal"><div class="eyebrow">Smart finds · Better living</div><h1>Discover what’s next.</h1><p>Curated everyday products, honest value and a smoother way to shop — all in one premium destination.</p><div class="hero-actions"><a class="btn btn-primary" href="{{ routes.collections_url }}">Shop the collection →</a><a class="btn btn-secondary" href="/collections/new-arrivals">Explore new arrivals</a></div><div class="hero-stats"><span>✦ Curated products</span><span>⌁ Better value</span><span>✓ Doorstep delivery</span></div></div><div class="hero-art" aria-hidden="true"></div></div></section>
<section class="trust"><div class="container trust-row"><div class="trust-item"><i class="trust-icon">✓</i>Secure Payments</div><div class="trust-item"><i class="trust-icon">↗</i>Fast Delivery</div><div class="trust-item"><i class="trust-icon">↻</i>Easy Returns</div><div class="trust-item"><i class="trust-icon">◇</i>Quality Products</div><div class="trust-item"><i class="trust-icon">⌁</i>24/7 Support</div></div></section>
<section class="section"><div class="container"><div class="section-head reveal"><div><div class="eyebrow">Explore the store</div><h2>Shop by category</h2><p class="muted">Start with what you need. Discover what you didn't.</p></div><a class="btn btn-secondary" href="{{ routes.collections_url }}">View all →</a></div><div class="grid category-grid">{% for collection in collections limit:8 %}<a class="category-card reveal" href="{{ collection.url }}">{% if collection.featured_image %}<img src="{{ collection.featured_image | image_url: width:800 }}" loading="lazy" alt="{{ collection.title | escape }}">{% endif %}<div class="category-copy"><h3>{{ collection.title }}</h3><span>Explore category →</span></div></a>{% endfor %}</div></div></section>
{% assign featured = collections['all'] %}<section class="section" style="padding-top:25px"><div class="container"><div class="section-head reveal"><div><div class="eyebrow">Limited-time selection</div><h2>Flash deals</h2><p class="muted">Live offers from your Shopify catalog.</p></div><div class="timer" data-countdown="24"><div class="timer-box"><strong data-hours>12</strong><small>Hours</small></div><div class="timer-box"><strong data-minutes>34</strong><small>Minutes</small></div><div class="timer-box"><strong data-seconds>56</strong><small>Seconds</small></div></div></div><div class="deal reveal"><div class="deal-head"><div><div class="eyebrow" style="color:#e7a52e">Fresh price drops</div><h2>Better products. Better prices.</h2></div><a class="btn btn-gold" href="/collections/deals">Shop all deals →</a></div><div class="grid products-grid">{% for product in featured.products limit:4 %}{% render 'product-card', product: product %}{% endfor %}</div></div></div></section>
<section class="section"><div class="container"><div class="section-head reveal"><div><div class="eyebrow">Curated for you</div><h2>Picked for you</h2><p class="muted">Discover products selected from your live Shopify catalog.</p></div><a class="btn btn-secondary" href="{{ routes.all_products_collection_url }}">View all →</a></div><div class="grid products-grid">{% for product in featured.products offset:4 limit:8 %}{% render 'product-card', product: product %}{% endfor %}</div></div></section>
<section class="section"><div class="container"><div class="section-head reveal"><div><div class="eyebrow">More ways to discover</div><h2>Shop your way.</h2></div></div><div class="grid discovery-grid"><a class="discovery-card reveal" href="/collections/best-sellers"><h3>Best Sellers →</h3><p class="muted">What's moving fastest.</p></a><a class="discovery-card reveal" href="/collections/new-arrivals"><h3>New Arrivals →</h3><p class="muted">Freshly added to the store.</p></a><a class="discovery-card reveal" href="/collections/under-499"><h3>Under ₹499 →</h3><p class="muted">Everyday value finds.</p></a><a class="discovery-card reveal" href="/collections/top-rated"><h3>Top Rated →</h3><p class="muted">Customer favourites from your catalog.</p></a></div></div></section>
<section class="section"><div class="container"><div class="newsletter reveal"><div><div class="eyebrow">Stay ahead</div><h2>Get the best finds first.</h2><p class="muted">New drops, useful discoveries and offers — without the noise.</p></div>{% form 'customer', class:'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="Enter your email address" required aria-label="Email address"><button class="btn btn-primary" type="submit">Subscribe</button>{% endform %}</div></div></section>