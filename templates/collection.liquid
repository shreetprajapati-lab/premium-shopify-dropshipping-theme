<section class="collection-hero"><div class="container"><div class="eyebrow">Shop collection</div><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<p class="muted">{{ collection.description | strip_html | truncate: 220 }}</p>{% endif %}</div></section><section class="section" style="padding-top:10px"><div class="container"><div class="collection-tools"><button class="btn btn-secondary filter-btn" type="button" data-filter-toggle>Filters</button><span class="muted">{{ collection.products_count }} products</span><select class="sort-select" aria-label="Sort products" data-sort><option value="manual">Featured</option><option value="price-ascending">Price: Low to high</option><option value="price-descending">Price: High to low</option><option value="created-descending">Newest</option><option value="best-selling">Best selling</option></select></div><div class="grid products-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products found in this collection yet.</p>{% endfor %}</div></div></section>