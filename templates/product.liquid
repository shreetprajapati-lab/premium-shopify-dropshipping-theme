<section class="product-page"><div class="container"><div class="product-layout"><div><div class="gallery-main"><img id="ProductImage" src="{{ product.featured_image | image_url: width:1400 }}" alt="{{ product.featured_image.alt | escape | default: product.title }}"></div><div class="thumbs">{% for image in product.images %}<button class="thumb" type="button" data-gallery-image="{{ image | image_url: width:1400 }}"><img src="{{ image | image_url: width:180 }}" loading="lazy" alt="{{ image.alt | escape | default: product.title }}"></button>{% endfor %}</div></div><div class="product-detail"><div class="eyebrow">{{ product.vendor | default: 'pickNbuy selection' }}</div><h1>{{ product.title }}</h1><div class="rating">★★★★★ <span class="muted">Customer reviews</span></div><div><span class="product-price">{{ product.price | money }}</span>{% if product.compare_at_price > product.price %}<span class="compare">{{ product.compare_at_price | money }}</span><span class="discount">{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% OFF</span>{% endif %}</div><div class="product-description">{{ product.description | truncate: 500 }}</div><form method="post" action="{{ routes.cart_add_url }}" id="ProductForm" data-product-form><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<label class="variant-label" for="Option-{{ forloop.index }}">{{ option.name }}</label><select class="variant-select" id="Option-{{ forloop.index }}" name="options[{{ option.name | escape }}]">{% for value in option.values %}<option value="{{ value | escape }}">{{ value }}</option>{% endfor %}</select>{% endfor %}{% endunless %}<label class="variant-label" for="Quantity">Quantity</label><input class="qty" id="Quantity" type="number" name="quantity" min="1" value="1"><div class="purchase-row"><button class="btn btn-primary" type="submit">Add to cart</button><button class="btn btn-gold buy-now" type="submit" name="buy_now" value="1">Buy now</button></div></form><div class="benefits"><div class="benefit"><span>✓</span>Secure checkout</div><div class="benefit"><span>↗</span>Fast delivery</div><div class="benefit"><span>↻</span>Easy returns</div><div class="benefit"><span>⌁</span>Support when you need it</div></div></div></div></div></section>