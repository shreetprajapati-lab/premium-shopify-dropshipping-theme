<article class="product-card reveal"><a href="{{ product.url }}" class="product-link"><div class="product-media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width:800 }}" loading="lazy" alt="{{ product.featured_image.alt | escape | default: product.title }}">{% endif %}{% if product.compare_at_price > product.price %}<span class="badge">SALE</span>{% endif %}<button type="button" class="icon-btn wishlist" aria-label="Add {{ product.title | escape }} to wishlist" data-wishlist>♡</button></div><div class="product-info"><h3>{{ product.title }}</h3><div class="rating">★★★★★ <span class="muted">Reviews</span></div><div class="price-row"><span class="price">{{ product.price | money }}</span>{% if product.compare_at_price > product.price %}<span class="compare">{{ product.compare_at_price | money }}</span><span class="discount">{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% OFF</span>{% endif %}</div></div></a><div class="quick-actions"><form method="post" action="{{ routes.cart_add_url }}" class="quick-add-form"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="btn btn-primary quick-add" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button></form><button type="button" class="btn btn-secondary quick-view" data-quick-view data-product-url="{{ product.url }}">Quick view</button></div></article>